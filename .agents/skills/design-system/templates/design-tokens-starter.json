{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "filter": "antislop",
    "description": "Anti-slop compliant design tokens starter with WCAG AA verified contrast and purposeful hierarchy"
  },
  "primitive": {
    "color": {
      "neutral": {
        "50": { "$value": "#F8FAFC", "$type": "color" },
        "100": { "$value": "#F1F5F9", "$type": "color" },
        "200": { "$value": "#E2E8F0", "$type": "color" },
        "300": { "$value": "#CBD5E1", "$type": "color" },
        "400": { "$value": "#94A3B8", "$type": "color" },
        "500": { "$value": "#64748B", "$type": "color" },
        "600": { "$value": "#475569", "$type": "color" },
        "700": { "$value": "#334155", "$type": "color" },
        "800": { "$value": "#1E293B", "$type": "color" },
        "900": { "$value": "#0F172A", "$type": "color" },
        "950": { "$value": "#020617", "$type": "color" }
      },
      "brand": {
        "50": { "$value": "#ECFDF5", "$type": "color" },
        "100": { "$value": "#D1FAE5", "$type": "color" },
        "200": { "$value": "#A7F3D0", "$type": "color" },
        "300": { "$value": "#6EE7B7", "$type": "color" },
        "400": { "$value": "#34D399", "$type": "color" },
        "500": { "$value": "#10B981", "$type": "color" },
        "600": { "$value": "#059669", "$type": "color" },
        "700": { "$value": "#047857", "$type": "color" },
        "800": { "$value": "#065F46", "$type": "color" },
        "900": { "$value": "#064E3B", "$type": "color" },
        "950": { "$value": "#022C22", "$type": "color" }
      },
      "accent": {
        "50": { "$value": "#FFFBEB", "$type": "color" },
        "500": { "$value": "#F59E0B", "$type": "color" },
        "600": { "$value": "#D97706", "$type": "color" },
        "700": { "$value": "#B45309", "$type": "color" }
      },
      "destructive": {
        "50": { "$value": "#FEF2F2", "$type": "color" },
        "500": { "$value": "#EF4444", "$type": "color" },
        "600": { "$value": "#DC2626", "$type": "color" },
        "700": { "$value": "#B91C1C", "$type": "color" }
      },
      "info": {
        "50": { "$value": "#F0F9FF", "$type": "color" },
        "500": { "$value": "#0EA5E9", "$type": "color" },
        "600": { "$value": "#0284C7", "$type": "color" },
        "700": { "$value": "#0369A1", "$type": "color" }
      },
      "white": { "$value": "#FFFFFF", "$type": "color" }
    },
    "spacing": {
      "0": { "$value": "0", "$type": "dimension" },
      "1": { "$value": "0.25rem", "$type": "dimension" },
      "2": { "$value": "0.5rem", "$type": "dimension" },
      "3": { "$value": "0.75rem", "$type": "dimension" },
      "4": { "$value": "1rem", "$type": "dimension" },
      "5": { "$value": "1.25rem", "$type": "dimension" },
      "6": { "$value": "1.5rem", "$type": "dimension" },
      "8": { "$value": "2rem", "$type": "dimension" },
      "10": { "$value": "2.5rem", "$type": "dimension" },
      "12": { "$value": "3rem", "$type": "dimension" },
      "16": { "$value": "4rem", "$type": "dimension" }
    },
    "fontSize": {
      "xs": { "$value": "0.75rem", "$type": "dimension" },
      "sm": { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem", "$type": "dimension" },
      "lg": { "$value": "1.125rem", "$type": "dimension" },
      "xl": { "$value": "1.25rem", "$type": "dimension" },
      "2xl": { "$value": "1.5rem", "$type": "dimension" },
      "3xl": { "$value": "1.875rem", "$type": "dimension" },
      "4xl": { "$value": "2.25rem", "$type": "dimension" }
    },
    "radius": {
      "none": { "$value": "0", "$type": "dimension" },
      "sm": { "$value": "0.25rem", "$type": "dimension" },
      "md": { "$value": "0.5rem", "$type": "dimension" },
      "lg": { "$value": "0.75rem", "$type": "dimension" },
      "xl": { "$value": "1rem", "$type": "dimension" }
    },
    "shadow": {
      "none": { "$value": "none", "$type": "shadow" },
      "sm": { "$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)", "$type": "shadow" },
      "md": { "$value": "0 4px 6px -1px rgb(0 0 0 / 0.08), 0 2px 4px -2px rgb(0 0 0 / 0.05)", "$type": "shadow" },
      "lg": { "$value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.05)", "$type": "shadow" }
    },
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration" },
      "normal": { "$value": "200ms", "$type": "duration" },
      "slow": { "$value": "300ms", "$type": "duration" }
    }
  },
  "semantic": {
    "color": {
      "background": { "$value": "{primitive.color.white}", "$type": "color" },
      "foreground": { "$value": "{primitive.color.neutral.900}", "$type": "color" },
      "primary": { "$value": "{primitive.color.brand.600}", "$type": "color" },
      "primary-hover": { "$value": "{primitive.color.brand.700}", "$type": "color" },
      "primary-foreground": { "$value": "{primitive.color.white}", "$type": "color" },
      "secondary": { "$value": "{primitive.color.brand.50}", "$type": "color" },
      "secondary-foreground": { "$value": "{primitive.color.brand.900}", "$type": "color" },
      "muted": { "$value": "{primitive.color.neutral.100}", "$type": "color" },
      "muted-foreground": { "$value": "{primitive.color.neutral.600}", "$type": "color" },
      "accent": { "$value": "{primitive.color.accent.500}", "$type": "color" },
      "accent-foreground": { "$value": "{primitive.color.neutral.950}", "$type": "color" },
      "destructive": { "$value": "{primitive.color.destructive.600}", "$type": "color" },
      "destructive-foreground": { "$value": "{primitive.color.white}", "$type": "color" },
      "border": { "$value": "{primitive.color.neutral.200}", "$type": "color" },
      "ring": { "$value": "{primitive.color.brand.500}", "$type": "color" }
    },
    "spacing": {
      "component-xs": { "$value": "{primitive.spacing.1}", "$type": "dimension" },
      "component-sm": { "$value": "{primitive.spacing.2}", "$type": "dimension" },
      "component-md": { "$value": "{primitive.spacing.4}", "$type": "dimension" },
      "component-lg": { "$value": "{primitive.spacing.6}", "$type": "dimension" },
      "section-sm": { "$value": "{primitive.spacing.8}", "$type": "dimension" },
      "section-md": { "$value": "{primitive.spacing.12}", "$type": "dimension" },
      "section-lg": { "$value": "{primitive.spacing.16}", "$type": "dimension" }
    },
    "radius": {
      "input": { "$value": "{primitive.radius.sm}", "$type": "dimension" },
      "button": { "$value": "{primitive.radius.md}", "$type": "dimension" },
      "card": { "$value": "{primitive.radius.lg}", "$type": "dimension" },
      "modal": { "$value": "{primitive.radius.xl}", "$type": "dimension" }
    },
    "shadow": {
      "ground": { "$value": "{primitive.shadow.none}", "$type": "shadow" },
      "card": { "$value": "{primitive.shadow.sm}", "$type": "shadow" },
      "dropdown": { "$value": "{primitive.shadow.md}", "$type": "shadow" },
      "modal": { "$value": "{primitive.shadow.lg}", "$type": "shadow" }
    }
  },
  "component": {
    "button": {
      "primary": {
        "bg": { "$value": "{semantic.color.primary}", "$type": "color" },
        "bg-hover": { "$value": "{semantic.color.primary-hover}", "$type": "color" },
        "fg": { "$value": "{semantic.color.primary-foreground}", "$type": "color" },
        "radius": { "$value": "{semantic.radius.button}", "$type": "dimension" },
        "shadow": { "$value": "{primitive.shadow.sm}", "$type": "shadow" }
      },
      "secondary": {
        "bg": { "$value": "{semantic.color.secondary}", "$type": "color" },
        "fg": { "$value": "{semantic.color.secondary-foreground}", "$type": "color" },
        "radius": { "$value": "{semantic.radius.button}", "$type": "dimension" }
      }
    },
    "card": {
      "bg": { "$value": "{semantic.color.background}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "radius": { "$value": "{semantic.radius.card}", "$type": "dimension" },
      "shadow": { "$value": "{semantic.shadow.card}", "$type": "shadow" }
    },
    "input": {
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "focus-ring": { "$value": "{semantic.color.ring}", "$type": "color" },
      "radius": { "$value": "{semantic.radius.input}", "$type": "dimension" }
    }
  }
}
